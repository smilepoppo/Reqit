{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Reqit のメインウィンドウに必要な最小限の権限",
  "windows": ["main"],
  "permissions": [
    "allow-send-request",
    "allow-cancel-request",
    "allow-load-last-request",
    "allow-save-last-request",
    "allow-parse-curl",
    "allow-export-curl"
  ]
}
