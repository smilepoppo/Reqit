# 改行コードを LF に統一する（Windows でも LF で管理）
* text=auto eol=lf

# Windows 専用スクリプトは CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# バイナリ
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.gif binary
*.woff binary
*.woff2 binary

# ロックファイルは差分表示を簡略化
pnpm-lock.yaml linguist-generated=true -diff
Cargo.lock linguist-generated=true
